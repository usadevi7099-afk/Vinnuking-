# Rename this file to .env and fill in your values (or set these as
# Environment Variables on your hosting platform e.g. Heroku/VPS/Railway).

# From https://my.telegram.org
API_ID=
API_HASH=

# From @BotFather
BOT_TOKEN=

# Generate with string_session_generator.py
STRING_SESSION=

# MongoDB connection string, e.g. from MongoDB Atlas
MONGO_DB_URI=

# Your personal Telegram user ID (owner of the bot)
OWNER_ID=

# Optional: group ID where /vclogger events are sent
LOG_GROUP_ID=

# Optional: from https://developer.spotify.com/dashboard
# Needed only if you want /play to accept Spotify track links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Railway-specific (only needed if deploying on Railway) ----
# Railway's builder ("Railpack") doesn't install ffmpeg by default.
# Add this as a Variable in the Railway dashboard (not read by the bot itself):
#   RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg
# If you ever see a "mise ERROR ... GitHub artifact attestations" build
# error, also add this Variable as a safety net:
#   MISE_PYTHON_GITHUB_ATTESTATIONS=false

# Branding
BOT_NAME=Vani X Music
BOT_USERNAME=your_bot_username
START_IMG=https://telegra.ph/file/your-start-image.jpg
SUPPORT_CHAT=https://t.me/YourSupportChat
UPDATES_CHANNEL=https://t.me/YourUpdatesChannel
